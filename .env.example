# Backend API origin (no trailing slash). Copy to `.env.local` for local dev.
# Production: set this to the deployed backend URL in the host's env vars.
VITE_API_BASE_URL=http://localhost:3000

# Optional: override the default demo player (must be outside the top 100 so the
# SelfRankCard shows out of the box). Falls back to p2500.
# VITE_DEFAULT_PLAYER_ID=p2500